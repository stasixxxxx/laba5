#define _CRT_SECURE_NO_DEPRECATE
#include <locale.h>
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

int task1(void);
int task2(void);
int task3(int A, int B, int C);

int main(void)
{
    setlocale(LC_ALL, "RUS");
    task1();
    task2();
    return 0;
}

int task1(void)
{
    double grad, aw;
    printf("Введите угол в градусах\n");
    scanf("%lf", &grad);
    aw = sin(grad * M_PI / 180);
    printf("sin(%.0f град) = %.6f\n", grad, aw);
    system("pause");
    return 0;
}

int task2(void)
{
    double x, y, a, b;
    double t = 0.43; 

    printf("Введите x (для теста введите 0.6):\n");
    scanf("%lf", &x);

    
    // 1. b = x * (t^3 + x)
    b = x * (pow(t, 3.0) + x);

    // 2. y = lg^3|x| + b
    y = pow(log10(fabs(x)), 3.0) + b;

    // 3. a = e^(2x) + sqrt(t)
    a = exp(2.0 * x) + sqrt(t);

    printf("Исходные данные: x = %.1f, t = %.2f\n", x, t);
    printf("Вычисленные значения: b = %.4f, y = %.4f, a = %.4f\n", b, y, a);

    task3((int)a, (int)b, (int)y);
    return 0;
}

int task3(int A, int B, int C)
{
    int a1, a2;

    a1 = (A % 2 == 0) != (B % 2 == 0);
    a2 = (A % 3 == 0) && (B % 3 == 0) && (C % 3 == 0);

    printf("Выделенные целые части: A = %d, B = %d, C = %d\n", A, B, C);
    printf("Только одно из чисел A и B четное, условие выполнено (1 - да, 0 - нет): %d\n", a1);
    printf("Каждое из чисел A, B, C кратно трем, условие выполнено (1 - да, 0 - нет): %d\n", a2);
    system("pause");
    return 0;
}